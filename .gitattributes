# Normalise text to LF in the repo. Without this, a shell script committed from
# Windows can land on Linux with CRLF and fail as:
#   ./setup.sh: /bin/bash^M: bad interpreter: No such file or directory
* text=auto eol=lf

*.sh   text eol=lf
*.py   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.md   text eol=lf
*.txt  text eol=lf

*.ps1  text eol=crlf

*.png  binary
*.jpg  binary
*.bin  binary
*.npz  binary
*.pt   binary
*.zip  binary
